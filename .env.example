# MongoDB connection. Default works with `npm run db` (bundled local MongoDB).
# For Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/bloodline
MONGODB_URI=mongodb://127.0.0.1:27017/bloodline

# Secret used to sign auth cookies. Change this in production!
JWT_SECRET=change-me-to-a-long-random-string

# Seed script centre point (defaults to New Delhi)
SEED_LAT=28.6139
SEED_LNG=77.2090
